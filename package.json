{
  "name": "qeltrun",
  "version": "0.1.0",
  "private": true,
  "description": "Nox-backed vendor-change payout firewall for Web3 treasuries.",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inspect:nox": "tsx scripts/inspect-nox.ts",
    "demo": "hardhat run scripts/demo.ts --network hardhatMainnet",
    "test:sol": "hardhat test solidity",
    "verify": "pnpm run typecheck && pnpm test && pnpm run compile && pnpm run test:sol && pnpm run export:abi",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "audit:slither": "slither contracts/QeltrunPayoutFirewall.sol --solc \"$(ls /root/.cache/hardhat-nodejs/compilers-v3/linux-amd64/solc-linux-amd64-v0.8.35*)\"",
    "export:abi": "tsx scripts/export-abi.ts",
    "node": "hardhat node",
    "setup:local": "hardhat run scripts/setup-local.ts --network localhost",
    "build:web": "pnpm --filter qeltrun-web build"
  },
  "dependencies": {
    "@iexec-nox/handle": "0.1.0-beta.13",
    "@iexec-nox/nox-confidential-contracts": "0.2.2",
    "@iexec-nox/nox-protocol-contracts": "0.2.4",
    "encrypted-types": "0.0.4",
    "ethers": "^6.17.0",
    "viem": "^2.33.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@types/node": "^22.13.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.11.0",
    "solhint": "^6.2.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
