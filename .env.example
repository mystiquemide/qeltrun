# Qeltrun environment template. Do not commit real secrets.
#
# Hardhat 3 reads these straight from the process environment; it does not load .env files.
# Export them in the shell that runs the command:
#
#   export $(grep -v '^#' .env | xargs) && pnpm run deploy:sepolia
#
# The web app reads NEXT_PUBLIC_* from web/.env.local at build time.

# --- Deployment (repo root) ---
SEPOLIA_RPC_URL=
PRIVATE_KEY=
ETHERSCAN_API_KEY=

# --- Web app (copy into web/.env.local) ---
# Leave these unset to run the dashboard against the local chain instead:
#   pnpm run node && pnpm run setup:local && pnpm --filter qeltrun-web dev
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_SEPOLIA_FIREWALL=
NEXT_PUBLIC_SEPOLIA_VENDOR_LABEL=vendor:northwind-logistics
NEXT_PUBLIC_SEPOLIA_VENDOR_ID=
NEXT_PUBLIC_SEPOLIA_PAYOUT_WALLET=
NEXT_PUBLIC_SEPOLIA_APPROVER=
