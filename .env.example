# Qeltrun environment template. Do not commit real secrets.
#
# Hardhat 3 reads these straight from the process environment; it does not load .env files.
# Export them in the shell that runs the command:
#
#   export $(grep -v '^#' .env | xargs) && pnpm run deploy:sepolia
#
# The web app reads NEXT_PUBLIC_* from web/.env.local at build time.

# --- Deployment (repo root) ---
SEPOLIA_RPC_URL=
PRIVATE_KEY=
TREASURY_SAFE=
ETHERSCAN_API_KEY=

# --- Web app (copy into web/.env.local) ---
# Leave these unset to run the dashboard against the local chain instead:
#   pnpm run node && pnpm run setup:local && pnpm --filter qeltrun-web dev
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_SEPOLIA_FIREWALL_V2=
NEXT_PUBLIC_SEPOLIA_VENDOR_LABEL=vendor:northwind-logistics
NEXT_PUBLIC_SEPOLIA_VENDOR_ID=
# Optional: only set where the Safe treasury path is wired.
NEXT_PUBLIC_SEPOLIA_SAFE_MODULE=
# The Safe that owns the firewall. Lets the console show a "register vendor" admin panel to
# whichever connected wallet is actually a Safe owner - everyone else never sees it.
NEXT_PUBLIC_SEPOLIA_TREASURY_SAFE=
# The destination the dashboard tests the gate against. Must not be the vendor's current payout
# wallet, or the dashboard opens on "allowed" with nothing to show. The deployed demo vendor
# already pays 0x3333...3333, so do not use that value.
NEXT_PUBLIC_SEPOLIA_PROPOSED_WALLET=0x4444444444444444444444444444444444444444
# Get a real id from https://cloud.reown.com for WalletConnect (mobile wallets). Injected wallets
# like MetaMask and Rabby work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# The production origin for social card image URLs. Defaults to https://qeltrun.vercel.app if unset.
NEXT_PUBLIC_SITE_URL=

# --- Live verification (pnpm run verify:live) ---
# The deployed firewall to exercise. Optionally DESTINATION and NONCE to pick the change.
FIREWALL_ADDRESS=
